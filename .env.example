# App
CORE_PORT=2000
APP_PORT=2001
API_PREFIX=api

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432
DB_NAME=db_name
# DB_SCHEMA=public   # optional — leave unset to use Postgres default schema "public"
# Database chứa schema auth của Supabase (cùng server với DATABASE_URL), dùng để lấy IP/thiết bị thật của log đăng nhập từ auth.sessions
# SUPABASE_AUTH_DB_NAME=postgres   # optional — mặc định postgres

# Upload (future cloud)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Bucket private (KHÔNG bật public access / r2.dev) cho tệp đính kèm tờ trình, tải qua presigned URL
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
# Đọc cả file từ R2 bằng nhiều kết nối song song (mặc định 6 x 4MB); R2_PARALLEL_DOWNLOADS=1 để tắt
R2_PARALLEL_DOWNLOADS=
R2_PARALLEL_CHUNK_SIZE_MB=

# Xem file bằng OnlyOffice Document Server
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=
# Document Server gọi về backend để tải tệp (trong docker: http://host.docker.internal:<APP_PORT>/<API_PREFIX>)
ONLYOFFICE_FILE_BASE_URL=
# ONLYOFFICE_VERIFY_DS_AUTH=true   # optional — đặt false nếu Document Server không gửi JWT khi tải tệp


# Frontend
FRONTEND_URL=http://localhost:3333

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

#supabase
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLISHABLE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret verify chữ ký hook "Before User Created" (POST /auth/hook/signup).
# Lấy: Supabase Dashboard > Authentication > Auth Hooks > Before User Created hook > Secret > Reveal
SUPABASE_HOOK_SECRET=
# Secret verify chữ ký hook "Custom Access Token" (POST /auth/hook/access-token), dùng để ghi log đăng nhập.
# Lấy: Supabase Dashboard > Authentication > Auth Hooks > Add hook > Customize Access Token (JWT) Claims hook > HTTPS endpoint, nhập URL <backend>/<API_PREFIX>/auth/hook/access-token > tạo secret
# Phải đặt biến này trước khi bật hook, nếu thiếu thì user không đăng nhập/refresh token được.
SUPABASE_ACCESS_TOKEN_HOOK_SECRET=

# Secret ký deviceId cấp cho trình duyệt (header X-Device-Id) để phát hiện đăng nhập trên thiết bị mới.
# Chuỗi ngẫu nhiên đủ dài, vd: openssl rand -hex 32. Không đặt thì bỏ qua kiểm tra thiết bị mới.
DEVICE_TOKEN_SECRET=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudflare KV (OTP cache)
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_KV_API_TOKEN=

# Cache (redis | cloudflare)
CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# RabbitMQ (optional — bỏ trống để disable email notification qua queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
